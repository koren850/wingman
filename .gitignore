node_modules
# Backward compatibility: the app folder was called "stage0" before the rename. Checkouts that were updated keep their
# own calls and private data there as untracked files; keep them out of git.
stage0/
app/calls/
app/data/gold/recordings/
app/data/gold/report-*.md
*.env
.DS_Store

# Generated test audio (rebuild with: cd app && pnpm run synth)
app/data/synthetic/*.wav
app/data/gold/synthetic.wav

# Client data snapshots (never committed)
app/data/private

# Synthetic QA (app/qa): rendered audio, TTS cache, QA call folders
app/qa/out/
app/qa/cache/
app/qa/calls/
app/qa/report-replay.*
app/.app/

# Never commit: logs, audio, local settings, secrets, builds, scratch
*.log
*.wav
*.mp3
*.m4a
.env
.env.*
*.pem
*.p12
*.dmg
app/data/briefs/
.claude/

# Personal session notes (never committed)
NEXT-SESSION.md
app/qa/report.json
app/qa/report.md

# Packaged app (pnpm dist): staged files and build output
app/.stage/
app/dist/

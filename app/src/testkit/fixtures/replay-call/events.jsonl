{"t": 1800000000000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "Thanks for joining. I am the facilities manager for the new office."}
{"t": 1800000020000, "type": "stt", "ch": "me", "final": true, "speechFinal": true, "text": "Happy to be here. We install and maintain the printers."}
{"t": 1800000040000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "How long does an installation take?"}
{"t": 1800000060000, "type": "stt", "ch": "me", "final": true, "speechFinal": true, "text": "Usually one day for the whole floor."}
{"t": 1800000080000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "We have about twelve printers and a budget of 5000."}
{"t": 1800000100000, "type": "stt", "ch": "me", "final": true, "speechFinal": true, "text": "That should fit."}
{"t": 1800000120000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "Our manager will not accept a contract longer than one year."}
{"t": 1800000140000, "type": "stt", "ch": "me", "final": true, "speechFinal": true, "text": "We can do twelve months."}
{"t": 1800000160000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "Do you also provide toner?"}
{"t": 1800000180000, "type": "stt", "ch": "me", "final": true, "speechFinal": true, "text": "Yes, toner is part of the service."}
{"t": 1800000200000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "Great. Let me check the calendar for next week."}
{"t": 1800000220000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "The weather is awful today."}
{"t": 1800000240000, "type": "stt", "ch": "me", "final": true, "speechFinal": true, "text": "Yes, it has been raining all day."}
{"t": 1800000260000, "type": "stt", "ch": "them", "final": true, "speechFinal": true, "text": "Send me the offer by Thursday, please."}

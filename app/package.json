{
  "name": "wingman-app",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "description": "Real-time answer cards for live calls on macOS, in English and Hebrew: hears both sides and shows a short answer in about a second. Electron and TypeScript.",
  "author": "koren850",
  "homepage": "https://github.com/koren850/wingman#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/koren850/wingman.git",
    "directory": "app"
  },
  "bugs": {
    "url": "https://github.com/koren850/wingman/issues"
  },
  "keywords": [
    "ai",
    "llm",
    "speech-to-text",
    "electron",
    "typescript",
    "copilot",
    "real-time",
    "deepgram",
    "claude"
  ],
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/run.ts",
    "overlay": "tsx src/overlay.ts",
    "gate": "tsx src/gate.ts",
    "detector": "tsx scripts/detector-test.ts",
    "synth": "tsx src/synth.ts",
    "doctor": "tsx src/doctor.ts",
    "diagnose": "tsx src/cli/index.ts diagnose",
    "test": "tsx --import ./src/test-setup.ts --test --test-concurrency=1 src/*.test.ts src/e2e/*.test.ts",
    "eval": "tsx scripts/eval.ts",
    "demo": "tsx scripts/demo.ts",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p tsconfig.cjs.json",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test:unit && pnpm eval",
    "test:unit": "tsx --import ./src/test-setup.ts --test --test-concurrency=1 src/*.test.ts",
    "test:e2e": "tsx --import ./src/test-setup.ts --test --test-concurrency=1 src/e2e/*.test.ts",
    "test:coverage": "tsx --import ./src/test-setup.ts --test --test-concurrency=1 --experimental-test-coverage --test-coverage-include=\"src/**\" --test-coverage-include=\"shared/**\" --test-coverage-include=\"tray/**\" --test-coverage-exclude=\"**/*.test.ts\" --test-coverage-exclude=\"src/test-*.ts\" src/*.test.ts src/e2e/*.test.ts",
    "call": "tsx src/call.ts",
    "brief": "tsx src/brief.ts",
    "factscheck": "tsx src/facts-check.ts",
    "tag": "tsx src/tag.ts",
    "summary": "tsx src/summary.ts",
    "dashboard": "scripts/wingman.sh --open-window",
    "tray": "scripts/wingman.sh",
    "purge": "tsx src/purge.ts",
    "banktest": "tsx scripts/bank-test.ts",
    "settings": "tsx src/settings-cli.ts",
    "keys": "tsx src/keys-cli.ts",
    "wingman": "tsx src/cli/index.ts",
    "qa": "tsx qa/run-qa.ts",
    "make-app": "scripts/make-app.sh",
    "postinstall": "node scripts/postinstall.cjs",
    "preinstall": "node scripts/check-env.cjs",
    "install-app": "scripts/make-app.sh --install",
    "dist": "node scripts/package-app.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.96",
    "@deepgram/sdk": "^5.18.0",
    "ai": "^7.0.162",
    "audiotee": "^0.0.7",
    "ulid": "^3.0.2",
    "ws": "8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^45.2.2",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  },
  "//": "Compilers: ESLint (typescript-eslint) needs the TypeScript 6 JS API, so 'typescript' is aliased to @typescript/typescript6. '@typescript/native' is TypeScript 7 and provides the 'tsc' binary used for type checking."
}

{
  "name": "wingman-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Wingman: a live meeting assistant for macOS (menu-bar app plus engine, Hebrew first). Listens locally, shows short answer cards on a second screen.",
  "license": "MIT",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "tsx src/run.ts",
    "overlay": "tsx src/overlay.ts",
    "gate": "tsx src/gate.ts",
    "detector": "tsx scripts/detector-test.ts",
    "synth": "tsx src/synth.ts",
    "doctor": "tsx src/doctor.ts",
    "test": "tsx --test --test-concurrency=1 src/*.test.ts",
    "call": "tsx src/call.ts",
    "brief": "tsx src/brief.ts",
    "factscheck": "tsx src/facts-check.ts",
    "tag": "tsx src/tag.ts",
    "summary": "tsx src/summary.ts",
    "dashboard": "scripts/wingman.sh --open-window",
    "tray": "scripts/wingman.sh",
    "purge": "tsx src/purge.ts",
    "banktest": "tsx scripts/bank-test.ts",
    "settings": "tsx src/settings-cli.ts",
    "keys": "tsx src/keys-cli.ts",
    "wingman": "tsx src/cli/index.ts",
    "qa": "tsx qa/run-qa.ts",
    "make-app": "scripts/make-app.sh",
    "postinstall": "node scripts/postinstall.cjs",
    "preinstall": "node scripts/check-env.cjs",
    "install-app": "scripts/make-app.sh --install",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@deepgram/sdk": "^5.17.0",
    "ai": "^7.0.159",
    "audiotee": "^0.0.7",
    "ulid": "^3.0.2",
    "ws": "8.22.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/ws": "^8.18.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "electron": "^45.2.1",
    "eslint": "^9.39.5",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1"
  }
}
